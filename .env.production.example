# Production Environment Variables Template
# Copy this file to .env.production and fill in your actual values

# Node Environment
NODE_ENV="production"

# Database
# PostgreSQL connection string for production
DATABASE_URL="postgresql://username:password@production-host:5432/subscribemeforai_prod?schema=public&connection_limit=10&pool_timeout=20"

# NextAuth
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-production-secret-key-here-minimum-32-characters-CHANGE-THIS"
# Your production application URL
NEXTAUTH_URL="https://yourdomain.com"

# Upstash Redis (Required for production rate limiting)
# Get these from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://your-production-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-production-redis-token"

# Sentry Error Monitoring (Optional but recommended)
# Get from: https://sentry.io/
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
SENTRY_ORG="your-org-name"
SENTRY_PROJECT="your-project-name"

# Application Settings
APP_URL="https://yourdomain.com"
PORT=3000

# Security
# CORS allowed origins (comma-separated)
CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Monitoring & Health Check
HEALTH_CHECK_SECRET="your-health-check-secret"

# Logging
LOG_LEVEL="info"
